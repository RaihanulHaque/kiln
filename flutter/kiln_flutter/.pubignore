# What pub.dev must NOT receive. pub uses this file INSTEAD of the .gitignore next to it, which
# is the point: src/core/ is git-ignored (it is generated) but must be published, because a
# pub.dev user does not have the rest of the repo.
# .gitignore files in parent folders still apply.

# generated by tools
.dart_tool/
/build/
/coverage/
/pubspec.lock
**/doc/api/
.flutter-plugins-dependencies
*.iml
.idea/
.DS_Store
*.log

# example app leftovers
example/build/
example/.dart_tool/
example/android/.gradle/
example/android/local.properties
example/ios/Pods/
example/ios/.symlinks/
example/ios/Flutter/ephemeral/
android/.gradle/
android/local.properties

# never ship model weights
*.gguf

# iOS is in progress and not declared in pubspec.yaml. Do not ship its files, and above all not
# ios/Frameworks: that is a compiled copy of the core and may be older than this version.
/ios/
example/ios/
