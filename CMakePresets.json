{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host (macOS/Linux, Release)",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (CPU, Release)",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "toolchainFile": "${sourceDir}/cmake/android-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_shared",
        "GGML_NATIVE": "OFF",
        "GGML_CPU_ARM_ARCH": "armv8.2-a+dotprod+fp16",
        "KILN_GPU": "OFF"
      }
    },
    {
      "name": "android-arm64-vulkan",
      "inherits": "android-arm64",
      "displayName": "Android arm64-v8a (Vulkan, experimental)",
      "binaryDir": "${sourceDir}/build/android-arm64-vulkan",
      "cacheVariables": { "KILN_GPU": "ON", "KILN_ANDROID_GPU": "vulkan" }
    }
  ],
  "buildPresets": [
    { "name": "host",                 "configurePreset": "host" },
    { "name": "android-arm64",        "configurePreset": "android-arm64" },
    { "name": "android-arm64-vulkan", "configurePreset": "android-arm64-vulkan" }
  ]
}
