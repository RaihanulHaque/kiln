 // conv subsampling + conformer encoder
+static ggml_tensor * parakeet_add_bias(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * b) {
+    return b ? ggml_add(ctx, cur, b) : cur;
+}
+
+// first subsampling conv: 1 input channel, 3x3, stride 2, pad 1, then bias and relu
+// src: mel [W, H], w [3, 3, 1, C], b [C]; dst: [C, W_out, H_out] (channels first)
+// one input value times a row of C weights per tap, so no dot products of length 9
+static void parakeet_conv0_op(ggml_tensor * dst, int ith, int nth, void * /*userdata*/) {
+    const ggml_tensor * src = dst->src[0];
+    const ggml_tensor * w   = dst->src[1];
+    const ggml_tensor * b   = dst->src[2];
+
+    const int64_t C  = dst->ne[0];
+    const int64_t WO = dst->ne[1];
+    const int64_t HO = dst->ne[2];
+    const int64_t W  = src->ne[0];
+    const int64_t H  = src->ne[1];
+
+    const float * x  = (const float *) src->data;
+    const float * wp = (const float *) w->data;
+    const float * bp = (const float *) b->data;
+
+    std::vector<float> wt(9 * C);
+    for (int64_t c = 0; c < C; ++c) {
+        for (int k = 0; k < 9; ++k) {
+            wt[k * C + c] = wp[c * 9 + k];
+        }
+    }
+
+    const int64_t h0 = (HO * ith) / nth;
+    const int64_t h1 = (HO * (ith + 1)) / nth;
+    for (int64_t oy = h0; oy < h1; ++oy) {
+        for (int64_t ox = 0; ox < WO; ++ox) {
+            float * out = (float *) dst->data + (oy * WO + ox) * C;
+            for (int64_t c = 0; c < C; ++c) {
+                out[c] = bp[c];
+            }
+            for (int ky = 0; ky < 3; ++ky) {
+                const int64_t iy = oy * 2 - 1 + ky;
+                if (iy < 0 || iy >= H) {
+                    continue;
+                }
+                for (int kx = 0; kx < 3; ++kx) {
+                    const int64_t ix = ox * 2 - 1 + kx;
+                    if (ix < 0 || ix >= W) {
+                        continue;
+                    }
+                    const float v = x[iy * W + ix];
+                    const float * wk = wt.data() + (ky * 3 + kx) * C;
+                    for (int64_t c = 0; c < C; ++c) {
+                        out[c] += v * wk[c];
+                    }
+                }
+            }
+            for (int64_t c = 0; c < C; ++c) {
+                out[c] = out[c] > 0.0f ? out[c] : 0.0f;
+            }
+        }
+    }
+}
